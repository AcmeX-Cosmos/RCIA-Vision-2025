<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema-instance"?>
<package format="3">
  <name>rcia_math_solver</name>
  <version>0.0.0</version>
  <description>Pose and ballistic solver package for ROS 2.</description>
  <maintainer email="AcmeX@foxmail.com">AcmeX</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rcia_vision_interfaces</depend>
  
  <build_depend>opencv4</build_depend>
  <exec_depend>opencv4</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
